# ─── Server Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Get this from your Neon dashboard → Connection Details → Connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/devtrackpro?sslmode=require

# If using Neon serverless driver (required for migrations on Neon):
# DIRECT_URL=postgresql://user:password@host/devtrackpro?sslmode=require

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_string_at_least_64_chars

# ── JWT Expiry ────────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your frontend app (no trailing slash)
# Development: http://localhost:5173
# Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
